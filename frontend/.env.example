# FastAPI backend base URL. In production set this to your Railway backend, e.g.
#   PUBLIC_API_BASE=https://water-body-watch-production.up.railway.app
# Leave empty only if the backend is served on the same origin as the frontend.
PUBLIC_API_BASE=

# Required for the Mapbox base map. Restrict the token by URL in the Mapbox dashboard.
PUBLIC_MAPBOX_TOKEN=
