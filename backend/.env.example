# Runtime
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Bhashini ULCA (ASR + translation + TTS). Get these from the Bhashini profile page.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
# BHASHINI_BASE_URL=https://meity-auth.ulcacontrib.org

# NVIDIA NIM / NeMo (OpenAI-compatible). Leave the key empty to use the local intent parser.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# OpenStreetMap. Nominatim requires a descriptive User-Agent; change the contact.
OSM_USER_AGENT=water-body-watch/0.1 (contact: your-team@example.org)
OVERPASS_URL=https://overpass.osm.ch/api
OVERPASS_MIRRORS=https://overpass-api.de/api,https://overpass.kumi.systems/api,https://overpass.private.coffee/api
OSM_DEFAULT_RADIUS_KM=5
OSM_MAX_BBOX_SPAN_DEG=0.20
OSM_MAX_RESULTS=60
OSM_MIN_AREA_M2=1000
OVERPASS_REQUEST_TIMEOUT_S=25

# Optional: override the bundled demo GeoJSON
# DEMO_GEOJSON_PATH=/absolute/path/to/demo_water_bodies.geojson

# Google Earth Engine / JRC Global Surface Water (Phase 2).
# Use a service-account JSON path or the JSON itself. Leave empty to use the
# deterministic synthetic series for offline demos.
GEE_SERVICE_ACCOUNT_JSON=
GEE_PROJECT=
JRC_COLLECTION=JRC/GSW1_4/MonthlyHistory
JRC_SCALE_M=30
HISTORY_YEARS=10
HISTORY_MIN_MONTHS=24
FLAG_DROP_PCT=15
HISTORY_INDEX_VERSION=jrc-gsw-v1
HISTORY_ALLOW_SYNTHETIC=true
HISTORY_LLM_ENABLED=true

# Sentinel Hub / Sentinel-2 L2A (Phase 3). OAuth client credentials.
# Leave empty to use the deterministic synthetic scene for offline demos.
SH_BASE_URL=https://services.sentinel-hub.com
SH_CLIENT_ID=
SH_CLIENT_SECRET=
SH_COLLECTION=sentinel-2-l2a
LIVE_LOOKBACK_DAYS=20
LIVE_MAX_CLOUD_PCT=60
LIVE_PIXEL_TARGET=192
LIVE_NDWI_THRESHOLD=0.5
LIVE_ALLOW_SYNTHETIC=true
LIVE_INDEX_VERSION=s2-ndwi-v1

# Phase 4 forensic thresholds.
FORENSIC_BUFFER_M=100
FORENSIC_VELOCITY_RATIO_THRESHOLD=1.5
FORENSIC_SHARED_RATIO_THRESHOLD=0.4
FORENSIC_STRAIGHTNESS_THRESHOLD=0.8
FORENSIC_NDBI_BUILT_THRESHOLD=10
FORENSIC_INDEX_VERSION=forensic-v1
FORENSIC_ALLOW_SYNTHETIC=true
FORENSIC_LLM_ENABLED=true

# Phase 5 vision validation. Only the NVIDIA VLM is supported; the
# deterministic fallback runs when NVIDIA is unavailable or disabled.
NVIDIA_VLM_MODEL=meta/llama-3.2-90b-vision-instruct
NVIDIA_VLM_TIMEOUT_S=8
VISION_LLM_ENABLED=true
VISION_ALLOW_SYNTHETIC=true
VISION_INDEX_VERSION=vision-v1
VISION_PATCH_SIZE_PX=256
